# Production build config for `mc-scripts build` (no secrets — safe to commit).
# On Vercel/Netlify, dashboard env vars override these values.
CLOUD_IDENTIFIER=gcp-au
CTP_PROJECT_KEY=metcash-demo
ENTRY_POINT_URI_PATH=retailer-onboarding

# Custom Application ID generated when the app was registered in Merchant Center.
CUSTOM_APPLICATION_ID=cmrlvjlvi002j01zjtzfekurd

# Deployed HTTPS domain — MUST match the Application URL registered in MC.
# Replace with your real domain (and set the same value in the host's env).
APPLICATION_URL=https://<your-deployed-domain>
